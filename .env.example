# Required for current daily AGMARKNET market-price data from data.gov.in.
# Use an API key intended for client-side use; VITE_ variables are visible in browser bundles.
VITE_DATA_GOV_API_KEY=your_data_gov_api_key

# Dealer product images use Cloudinary unsigned browser uploads.
# These values are public configuration; never put your Cloudinary API secret here.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
